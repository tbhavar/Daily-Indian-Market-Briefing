# Google AI Studio API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gmail Sender account (the bot email)
EMAIL_SENDER=YOUR_BOT_EMAIL@gmail.com

# Gmail App Password (16 digits)
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE

# API key for IPO data (from ipoalerts.in)
IPOALERTS_API_KEY=YOUR_IPOALERTS_API_KEY_HERE

# Published Google Sheets CSV URL for subscribers
SUBSCRIBERS_CSV_URL=YOUR_SUBSCRIBERS_CSV_URL_HERE

# Google Form URL for subscription/unsubscription
GOOGLE_FORM_URL=YOUR_GOOGLE_FORM_URL_HERE
